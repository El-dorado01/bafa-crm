generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CLIENT
  CONSULTANT
  FUNDING_ADVISOR
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      UserRole @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  clientProjects     Project[]       @relation("ClientProjects")
  consultantProjects Project[]       @relation("ConsultantProjects")
  messages           Communication[]
  uploadedDocuments  Document[]
  profile            Profile?
}

model Profile {
  id           String @id @default(uuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String?
  address      String?
  legalForm    String?
  foundingDate DateTime?
  industry     String?
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clientId     String
  client       User   @relation("ClientProjects", fields: [clientId], references: [id])
  consultantId String?
  consultant   User?  @relation("ConsultantProjects", fields: [consultantId], references: [id])

  caseStatusId String
  caseStatus   CaseStatus @relation(fields: [caseStatusId], references: [id])

  documents      Document[]
  communications Communication[]
}

model CaseStatus {
  id          String    @id @default(uuid())
  name        String    @unique // e.g., "Lead", "Eligibility Review", etc.
  description String?
  order       Int       @unique // To maintain the flow order
  projects    Project[]
}

model DocumentType {
  id          String     @id @default(uuid())
  name        String     @unique // e.g., "Gewerbeanmeldung", "Bericht"
  description String?
  documents   Document[]
}

model DocumentState {
  id          String     @id @default(uuid())
  name        String     @unique // e.g., "Requested", "Uploaded", "Approved"
  description String?
  documents   Document[]
}

model Document {
  id        String   @id @default(uuid())
  filePath  String
  fileName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  typeId String
  type   DocumentType @relation(fields: [typeId], references: [id])

  stateId String
  state   DocumentState @relation(fields: [stateId], references: [id])

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
}

model Communication {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])
}
